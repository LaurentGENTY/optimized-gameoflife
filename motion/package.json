{
  "name": "gameoflife-motion",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "still": "node scripts/still.ts",
    "capture": "playwright test --config playwright.capture.config.ts && rm -rf public/app && mkdir -p public/app && ffmpeg -y -loglevel error -i out/app.webm -ss 1 -t 12 -vf fps=60 -q:v 3 public/app/%04d.jpg",
    "render": "node scripts/render.ts",
    "encode": "bash scripts/encode.sh",
    "check": "node scripts/check-outputs.ts"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
